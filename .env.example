# Copy to .env and edit. All variables use the FFLIKE_ prefix.

FFLIKE_ENVIRONMENT=development

# Comma-separated API keys. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
FFLIKE_API_KEYS=change-me

# test     = simulated likes, no real accounts touched (default)
# official = forward to an authorized partner API (settings below)
FFLIKE_PROVIDER_MODE=test

FFLIKE_RATE_LIMIT_REQUESTS=30
FFLIKE_RATE_LIMIT_WINDOW_SECONDS=60
FFLIKE_DAILY_LIKES_PER_UID=100

# Official mode only. Must be an HTTPS API you have written permission to use.
FFLIKE_OFFICIAL_API_BASE_URL=
FFLIKE_OFFICIAL_API_TOKEN=
FFLIKE_OFFICIAL_API_ALLOWED_HOSTS=
FFLIKE_OFFICIAL_API_TIMEOUT_SECONDS=10
